BOT_TOKEN=токен_от_BotFather
# Через запятую Telegram ID, кому можно пользоваться ботом. Пусто = всем.
ALLOWED_USERS=

# Качество звука с YouTube: пусто = стандартное (AAC 128 кбит/с), fast = файлы в 2-3 раза меньше и быстрее
AUDIO_QUALITY=


# --- дашборд (мини-апп) ---
WEBAPP_PORT=8080
# Свой постоянный https-адрес. Пусто = бот сам поднимет туннель Cloudflare (адрес меняется при запуске)
WEBAPP_URL=

# Telegram ID админа (команда /admin открывает админку). Не знаете ID: отправьте боту /admin, он его покажет
ADMIN_USERS=
