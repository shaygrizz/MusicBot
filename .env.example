BOT_TOKEN=token_from_BotFather
# Comma-separated Telegram IDs allowed to use the bot. Empty means everyone.
ALLOWED_USERS=

# YouTube audio quality: empty = standard (AAC 128 kbit/s), fast = files 2-3 times smaller and quicker
AUDIO_QUALITY=

# --- dashboard (Mini App) ---
WEBAPP_PORT=8080
# Your own permanent https address. Empty = the bot starts a Cloudflare tunnel (the address changes on every start)
WEBAPP_URL=

# Telegram IDs that may open /admin. Not sure of your ID? Send /admin to the bot and it will show it
ADMIN_USERS=

# Seconds to wait for fast search sources (default 3); raise it on slow hosts
# SEARCH_FAST_DEADLINE=6
