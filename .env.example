BOT_TOKEN=token_from_BotFather
# Comma-separated Telegram IDs allowed to use the bot. Empty means everyone.
ALLOWED_USERS=

# YouTube audio quality: empty = standard (AAC 128 kbit/s), fast = files 2-3 times smaller and quicker
AUDIO_QUALITY=

# --- dashboard (Mini App) ---
WEBAPP_PORT=8080
# Your own permanent https address. Empty = the bot starts a Cloudflare tunnel (the address changes on every start)
WEBAPP_URL=

# Telegram IDs that may open /admin. Not sure of your ID? Send /admin to the bot and it will show it
ADMIN_USERS=

# Seconds to wait for fast search sources (default 3); raise it on slow hosts
# SEARCH_FAST_DEADLINE=6

# --- speed ---
# Search answers early once the fast sources found the exact track (0 = always wait for slow sources too)
# SEARCH_EARLY_EXIT=1
# How many results the early answer needs (default 3)
# SEARCH_EARLY_MIN=3
# Seconds a search result is reused, from memory and from the database after a restart (default 12 hours)
# SEARCH_CACHE_TTL=43200
# Seconds between pings that keep YouTube Music and catalog connections warm (0 = only once at startup)
# WARM_INTERVAL=45
# Disk space for the shared audio cache: a song downloaded once is served from disk to everyone (default 1000 MB; it shares the disk with the database, keep headroom)
# AUDIO_CACHE_MB=1000
# At most this many YouTube link extractions at once (default 3); more raises the risk of an IP block
# YT_EXTRACT_PARALLEL=3

# --- YouTube blocks ---
# YouTube closes the IPs of data centers ("Sign in to confirm you're not a bot"). The bot then skips YouTube for 2 minutes
# and downloads from the fallback sources (hitmotop, SoundCloud, dydki). To keep downloading from YouTube itself:
# 1) put cookies.txt (Netscape format, exported from a browser where you are logged in) into DATA_DIR, or
# 2) route all YouTube traffic through a proxy (a residential one works best):
# YT_PROXY=http://user:pass@host:port

# --- playlists ---
# Songs sent per tap from a playlist link (default 10)
# PLAYLIST_BATCH=10
# Most songs read from one playlist link (default 200)
# PLAYLIST_MAX=200
# Playlists sent at the same time across all users (default 2); the server CPU and YouTube limits are the bottleneck
# PLAYLIST_JOBS=2
# Disk space for the favorites audio cache (default 1500 MB)
# FAV_CACHE_MB=1500
